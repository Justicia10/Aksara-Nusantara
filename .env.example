# ---- Server ----
PORT=3000
NODE_ENV=development
# SQLite file (created automatically). Default: ./data/ngm.db
DATABASE_PATH=./data/ngm.db

# ---- Admin / sessions ----
# Required in production: a long random string (e.g. `openssl rand -hex 32`). Never commit a real value.
SESSION_SECRET=replace-with-a-long-random-string
# Created on first start if the user does not exist. There is NO default password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Set to "false" only when serving production over plain HTTP (e.g. a local test); keeps the Secure flag otherwise.
COOKIE_SECURE=true

# ---- AI visual generation (server-side only; never exposed to the browser) ----
# Without this key the "Buat visual AI" action returns a clear 503 and creates nothing.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
